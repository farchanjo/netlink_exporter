[Unit]
Description=nft_exporter — Linux netlink Prometheus exporter
Documentation=https://github.com/farchanjo/netlink_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Operator env overrides (NLX_*) — optional file (the `-` tolerates its absence).
EnvironmentFile=-/etc/default/nft_exporter
ExecStart=/usr/bin/netlink_exporter --config /etc/nft_exporter/nft_exporter.toml

# Least privilege (ADR-0009): runs as the unprivileged nft-exporter user.
# The drop_monitor collector (default-on) joins the NET_DM multicast group at
# startup, which needs CAP_SYS_ADMIN (ADR-0026); CAP_NET_ADMIN covers the rest.
# These startup caps are granted via FILE CAPABILITIES on the binary
# (`setcap cap_net_admin,cap_sys_admin=ep`, applied by the package postinst) —
# systemd AmbientCapabilities does NOT satisfy the NET_DM join, file caps do.
# The binary drops its effective set to CAP_NET_ADMIN right after the join.
# File capabilities are honoured only when NoNewPrivileges is OFF.
User=nft-exporter
Group=nft-exporter
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=false

ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
