[Unit]
Description=nft_exporter — Linux netlink Prometheus exporter
Documentation=https://github.com/farchanjo/netlink_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Operator env overrides (NLX_*) — optional file (the `-` tolerates its absence).
EnvironmentFile=-/etc/default/nft_exporter
ExecStart=/usr/bin/netlink_exporter --config /etc/nft_exporter/nft_exporter.toml

# Least privilege (ADR-0009): unprivileged user + only the caps the exporter needs.
# The process opens netlink sockets then drops to CAP_NET_ADMIN itself.
# CAP_NET_ADMIN: netlink. CAP_SYS_ADMIN: the drop_monitor collector (default-on)
# joins the NET_DM multicast group at startup (ADR-0026); drop it if you disable
# drop_monitor (NLX_COLLECTORS__DROP_MONITOR=false).
User=nft-exporter
Group=nft-exporter
AmbientCapabilities=CAP_NET_ADMIN CAP_SYS_ADMIN
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
