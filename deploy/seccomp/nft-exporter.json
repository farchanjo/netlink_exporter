{
  "_comment": [
    "Seccomp profile for nft_exporter (ADR-0009, ADR-0023).",
    "Base: RuntimeDefault (moby/containerd) plus explicit ALLOW for the three",
    "io_uring syscalls that RuntimeDefault denies by default.",
    "",
    "Syscalls explicitly allowed beyond RuntimeDefault:",
    "  io_uring_setup   (425) — create an io_uring instance (monoio init)",
    "  io_uring_enter   (426) — submit/wait on SQ/CQ entries",
    "  io_uring_register(427) — register buffers, files, eventfd with io_uring",
    "",
    "Syscalls explicitly denied (SCMP_ACT_ERRNO EPERM):",
    "  execve, execveat  — no subprocess execution",
    "  ptrace            — no process tracing",
    "  bpf               — no BPF program loading",
    "  perf_event_open   — no perf events",
    "  clone(CLONE_NEWUSER) — no user namespace creation",
    "",
    "All other syscalls default to SCMP_ACT_ERRNO (same as RuntimeDefault).",
    "Deploy to: /var/lib/kubelet/seccomp/nft-exporter.json on each node.",
    "Reference in DaemonSet via: seccompProfile.type=Localhost,",
    "  localhostProfile=nft-exporter.json"
  ],
  "defaultAction": "SCMP_ACT_ERRNO",
  "architectures": [
    "SCMP_ARCH_X86_64",
    "SCMP_ARCH_AARCH64"
  ],
  "syscalls": [
    {
      "names": [
        "accept4",
        "bind",
        "brk",
        "clock_gettime",
        "close",
        "connect",
        "dup",
        "dup2",
        "dup3",
        "epoll_create1",
        "epoll_ctl",
        "eventfd2",
        "exit",
        "exit_group",
        "fstat",
        "fstatfs",
        "futex",
        "getpid",
        "getppid",
        "getrandom",
        "getsockname",
        "getsockopt",
        "gettid",
        "getuid",
        "listen",
        "madvise",
        "mmap",
        "mprotect",
        "munmap",
        "nanosleep",
        "openat",
        "pipe2",
        "poll",
        "pread64",
        "read",
        "recvfrom",
        "recvmsg",
        "restart_syscall",
        "rt_sigaction",
        "rt_sigprocmask",
        "rt_sigreturn",
        "sched_getaffinity",
        "sched_yield",
        "sendmsg",
        "sendto",
        "set_robust_list",
        "set_tid_address",
        "setsockopt",
        "sigaltstack",
        "socket",
        "stat",
        "statfs",
        "tgkill",
        "uname",
        "wait4",
        "write"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "io_uring syscalls — required by monoio 0.2 (ADR-0023). Denied by RuntimeDefault.",
      "names": [
        "io_uring_setup",
        "io_uring_enter",
        "io_uring_register"
      ],
      "action": "SCMP_ACT_ALLOW"
    },
    {
      "_comment": "Explicit denials — belt-and-suspenders on top of defaultAction ERRNO.",
      "names": [
        "execve",
        "execveat"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "names": [
        "ptrace"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "names": [
        "bpf"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    },
    {
      "names": [
        "perf_event_open"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
